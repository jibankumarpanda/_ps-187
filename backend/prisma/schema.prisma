// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum CameraSourceType {
  RTSP
  VIDEO
}

enum VideoJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  COMMANDER
  BOP_OPERATOR
  ANALYST
  INVESTIGATOR
  AUDITOR
}

enum CameraStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum AiStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum BopStatus {
  OPERATIONAL
  DEGRADED
  OFFLINE
}

enum EventType {
  PERSON_DETECTED
  VEHICLE_DETECTED
  ANPR_MATCH
  FACE_MATCH
  INTRUSION
  LOITERING
  ABANDONED_OBJECT
  SUSPICIOUS_ACTIVITY
  NIGHT_ACTIVITY
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ObjectType {
  PERSON
  VEHICLE
  FACE
  PLATE
  OBJECT
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  ESCALATED
}

enum EvidenceType {
  SNAPSHOT
  VIDEO_CLIP
  FRAME
  METADATA
}

enum VerificationStatus {
  VERIFIED
  FAILED
  PENDING
  NOT_VERIFIED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CAMERA_CREATED
  CAMERA_UPDATED
  CAMERA_DELETED
  CAMERA_STARTED
  CAMERA_STOPPED
  EVENT_VIEWED
  ALERT_ACKNOWLEDGED
  ALERT_RESOLVED
  EVIDENCE_VIEWED
  EVIDENCE_VERIFIED
  WATCHLIST_UPDATED
  BLOCKCHAIN_REGISTERED
  USER_REGISTERED
  EMAIL_VERIFIED
}

// ─── MODELS ──────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(BOP_OPERATOR)
  employeeId          String?   @unique
  isEmailVerified     Boolean   @default(false)
  emailVerificationCode String?
  emailVerificationExpiry DateTime?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  refreshToken        String?
  lastLoginAt         DateTime?
  lastLoginIp         String?

  // Face verification (128-d descriptor from face-api.js)
  faceDescriptor      Float[]
  faceEnrolledAt      DateTime?

  // BOP assignment for resource-level authorization
  assignedBopId       String?
  assignedBop         Bop?      @relation(fields: [assignedBopId], references: [id])

  // Relations
  auditLogs           AuditLog[]
  alerts              Alert[]   @relation("AssignedAlerts")

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([assignedBopId])
}

model Bop {
  id          String    @id @default(uuid())
  code        String    @unique    // e.g. BOP-12
  name        String
  location    String
  latitude    Float
  longitude   Float
  status      BopStatus @default(OPERATIONAL)

  // Relations
  cameras     Camera[]
  events      Event[]
  alerts      Alert[]
  evidence    Evidence[]
  users       User[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([status])
}

model Camera {
  id                    String       @id @default(uuid())
  cameraCode            String       @unique    // e.g. BOP12-CAM01
  name                  String
  location              String
  sourceType            CameraSourceType @default(RTSP)
  videoPath             String?
  status                CameraStatus @default(OFFLINE)
  fps                   Int          @default(0)
  resolution            String       @default("1920x1080")
  aiStatus              AiStatus     @default(INACTIVE)
  lastSeen              DateTime?
  latitude              Float
  longitude             Float
  streamUrl             String?

  // Encrypted RTSP credentials (AES-256-GCM)
  rtspUsernameEncrypted String?
  rtspPasswordEncrypted String?

  // BOP relation
  bopId                 String
  bop                   Bop          @relation(fields: [bopId], references: [id])

  // Relations
  zones                 CameraZone[]
  events                Event[]
  detections            Detection[]
  alerts                Alert[]
  evidence              Evidence[]
  videoJobs             VideoAnalysis[]

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([bopId])
  @@index([status])
  @@index([cameraCode])
}

model CameraZone {
  id          String  @id @default(uuid())
  name        String
  zoneType    String  // e.g. RESTRICTED, MONITORING, CHECKPOINT
  coordinates Json    // Polygon coordinates
  isActive    Boolean @default(true)

  cameraId    String
  camera      Camera  @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cameraId])
}

model Event {
  id          String     @id @default(uuid())
  eventCode   String     @unique  // e.g. EVT-10001
  eventType   EventType
  objectType  ObjectType
  trackId     Int?
  confidence  Float
  zone        String
  severity    Severity
  threatScore Int
  status      String     @default("NEW")  // NEW, ACKNOWLEDGED, INVESTIGATING, RESOLVED
  direction   String?
  timestamp   DateTime

  // Relations
  cameraId    String
  camera      Camera     @relation(fields: [cameraId], references: [id])
  bopId       String
  bop         Bop        @relation(fields: [bopId], references: [id])

  detections  Detection[]
  alerts      Alert[]
  evidence    Evidence[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([cameraId])
  @@index([bopId])
  @@index([eventType])
  @@index([severity])
  @@index([timestamp])
  @@index([eventCode])
}

model Detection {
  id         String     @id @default(uuid())
  objectType ObjectType
  trackId    Int
  confidence Float
  bboxX      Float
  bboxY      Float
  bboxW      Float
  bboxH      Float
  label      String?
  timestamp  DateTime

  eventId    String
  event      Event      @relation(fields: [eventId], references: [id])
  cameraId   String
  camera     Camera     @relation(fields: [cameraId], references: [id])

  createdAt  DateTime   @default(now())

  @@index([eventId])
  @@index([cameraId])
}

model Alert {
  id          String      @id @default(uuid())
  alertCode   String      @unique  // e.g. ALT-10001
  eventType   String
  severity    Severity
  threatScore Int
  status      AlertStatus @default(NEW)
  description String
  assignedToId String?
  assignedTo   User?      @relation("AssignedAlerts", fields: [assignedToId], references: [id])
  resolvedAt  DateTime?
  acknowledgedAt DateTime?
  escalatedAt DateTime?
  timestamp   DateTime

  // Relations
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id])
  cameraId    String
  camera      Camera     @relation(fields: [cameraId], references: [id])
  bopId       String
  bop         Bop        @relation(fields: [bopId], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([severity])
  @@index([bopId])
  @@index([alertCode])
  @@index([timestamp])
}

model Evidence {
  id                 String             @id @default(uuid())
  evidenceCode       String             @unique  // e.g. EVD-10001
  evidenceType       EvidenceType
  hash               String             // SHA-256 hash
  filePath           String?
  fileSizeKB         Int?
  recordedBy         String
  recordedOrg        String
  verificationStatus VerificationStatus @default(PENDING)
  timestamp          DateTime

  // Relations
  eventId            String
  event              Event              @relation(fields: [eventId], references: [id])
  cameraId           String
  camera             Camera             @relation(fields: [cameraId], references: [id])
  bopId              String
  bop                Bop                @relation(fields: [bopId], references: [id])

  blockchainRecords  BlockchainRecord[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([eventId])
  @@index([evidenceCode])
  @@index([verificationStatus])
}

model WatchlistPerson {
  id          String   @id @default(uuid())
  referenceId String   @unique  // e.g. WLP-001
  name        String
  status      String   @default("ACTIVE")  // ACTIVE, INACTIVE
  lastMatch   DateTime?
  addedBy     String
  description String?
  category    String   // e.g. SUSPECT, POI, MISSING

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([referenceId])
  @@index([status])
}

model WatchlistVehicle {
  id          String   @id @default(uuid())
  vehicleId   String   @unique  // e.g. WLV-001
  numberPlate String
  vehicleType String
  status      String   @default("ACTIVE")
  lastMatch   DateTime?
  addedBy     String
  description String?
  category    String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
  @@index([numberPlate])
  @@index([status])
}

model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  resource   String      // e.g. "Camera", "Evidence"
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime    @default(now())

  userId     String
  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([resource])
}

model BlockchainRecord {
  id             String   @id @default(uuid())
  transactionId  String   @unique
  blockNumber    Int
  ledger         String   @default("ibvap-evidence-ledger")
  evidenceHash   String
  recordedOrg    String
  recordedBy     String
  channel        String   @default("evidence-channel")
  chaincode      String   @default("ibvap-evidence-cc")
  timestamp      DateTime

  evidenceId     String
  evidence       Evidence @relation(fields: [evidenceId], references: [id])

  createdAt      DateTime @default(now())

  @@index([evidenceId])
  @@index([transactionId])
}

model VideoAnalysis {
  id                 String         @id @default(uuid())
  cameraId           String
  filename           String
  originalPath       String
  processedPath      String?
  status             VideoJobStatus @default(QUEUED)
  progress           Int            @default(0)
  totalFrames        Int?
  processedFrames    Int?
  fps                Float?
  duration           Float?
  personsDetected    Int            @default(0)
  vehiclesDetected   Int            @default(0)
  intrusionCount     Int            @default(0)
  loiteringCount     Int            @default(0)
  nightCount         Int            @default(0)
  faceMatchCount     Int            @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  error              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  camera             Camera         @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  events             VideoEvent[]
}

model VideoEvent {
  id                 String         @id @default(uuid())
  videoId            String
  type               String
  severity           String
  timestamp          Float
  frameNumber        Int?
  confidence         Float?
  trackId            String?
  description        String?
  evidenceId         String?
  metadata           Json?
  createdAt          DateTime       @default(now())

  video              VideoAnalysis  @relation(fields: [videoId], references: [id], onDelete: Cascade)
}
