# ══════════════════════════════════════════════════════════════════════════════
# IBVAP ML – Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Do NOT commit real values. On Hugging Face Spaces, set secrets in
#   Settings → Variables and secrets (they are injected as env vars at runtime).
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────────────
# PORT is set automatically by HF Spaces (default 7860). Override only locally.
# PORT=7860

# ── YOLO ─────────────────────────────────────────────────────────────────────
# MODEL_PATH=yolo11n.pt
# CONFIDENCE_THRESHOLD=0.35
# IOU_THRESHOLD=0.5

# ── PaddleOCR ────────────────────────────────────────────────────────────────
# OCR_THRESHOLD=0.5

# ── ONNX / Face Recognition ─────────────────────────────────────────────────
# FACE_MODEL_PATH=.insightface/buffalo_l/w600k_r50.onnx
# FACE_RECOGNITION_THRESHOLD=0.45

# ── Upload Guards ────────────────────────────────────────────────────────────
# MAX_IMAGE_BYTES=20971520
# MAX_IMAGE_EDGE=2048

# ── BullMQ / Redis (optional) ───────────────────────────────────────────────
# Set REDIS_URL to enable async job queue. Without it the /jobs endpoints
# return 503 gracefully – the rest of the API works fine.
# REDIS_URL=redis://localhost:6379
# QUEUE_NAME=ibvap-inference

# ── Backend forwarding (optional) ───────────────────────────────────────────
# BACKEND_URL=http://localhost:4000/api
